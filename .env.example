# copy to ~/.pi/agent/.env and fill in
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Optional: Cline API key; OAuth via /login cline-proxy is preferred for FREE quota.
CLINE_API_KEY=
# Experiential Labs gateway. extensions/proxy reads this and registers
# experiential/deepseek-v4.1-flash-uncensored. Create the key under Settings -> API Keys.
EXPLABS_API_KEY=
